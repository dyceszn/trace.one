# ================================================================
# Trace.One — Environment Variables
# Copy this file to .env.local and fill in your values.
# ================================================================

# ------------------------------------------------------------
# PRIMARY: Groq (free tier, fast inference, streaming support)
# Sign up at https://console.groq.com and create an API key.
# The free tier provides generous rate limits for development.
# ------------------------------------------------------------
GROQ_API_KEY=gsk_your_key

# ------------------------------------------------------------
# OPTIONAL: Switch AI provider
# See src/app/api/chat/route.ts to swap to another provider.
# Supported providers via @ai-sdk: anthropic, mistral, cohere, etc.
# ------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# MISTRAL_API_KEY=...

# ------------------------------------------------------------
# OPTIONAL: Supabase (for future persistent storage)
# Leave blank to use ephemeral in-memory mode (default).
# ------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
